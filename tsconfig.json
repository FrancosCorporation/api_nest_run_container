{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "skipLibCheck": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "incremental": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    ".docker"
  ]
}
